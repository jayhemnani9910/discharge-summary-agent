# Copy this file to ".env" and fill in the key(s) you need. ".env" is gitignored.
#
# Two LLM roles: VISION (OCR of the scanned pages) and CHAT (the reasoning loop + verifier).
# They can be the same provider or different ones.

# --- Option A: Gemini for both vision and reasoning (live OCR) ---------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Multiple keys (comma-separated) are rotated automatically on a 429/quota error. The free tier
# is limited per key per day, so a long PDF needs several keys to transcribe in one run:
# GEMINI_API_KEYS=key1,key2,key3
# CHAT_PROVIDER=gemini
# VISION_PROVIDER=gemini

# --- Option B: DeepSeek reasoning over a pre-extracted transcript ------------
# DeepSeek has no vision; pass --transcript reference/ground_truth_transcript.json
# Key: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your-deepseek-key-here
# CHAT_PROVIDER=deepseek

# --- Optional overrides (defaults shown) ------------------------------------
# Defaults are gemini-2.5-flash. Do NOT use gemini-2.0-flash for vision: on a normal key it has
# free-tier quota limit:0 and returns 429 on every page.
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash
# Comma-separated model fallback lists, tried in order when a model is quota-exhausted on all keys:
# GEMINI_VISION_MODELS=gemini-2.5-flash
# GEMINI_CHAT_MODELS=gemini-2.5-flash
# DEEPSEEK_MODEL=deepseek-chat
# AGENT_MAX_STEPS=120
