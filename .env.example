# Copy this file to ".env" and fill in the key(s) you need. ".env" is gitignored.
#
# Two LLM roles: VISION (OCR of the scanned pages) and CHAT (the reasoning loop + verifier).
# They can be the same provider or different ones.

# --- Option A: Gemini for both vision and reasoning (live OCR) ---------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# CHAT_PROVIDER=gemini
# VISION_PROVIDER=gemini

# --- Option B: DeepSeek reasoning over a pre-extracted transcript ------------
# DeepSeek has no vision; pass --transcript reference/ground_truth_transcript.json
# Key: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your-deepseek-key-here
# CHAT_PROVIDER=deepseek

# --- Optional overrides (defaults shown) ------------------------------------
# GEMINI_CHAT_MODEL=gemini-2.0-flash      # gemini-2.5-flash for higher quality if quota allows
# GEMINI_VISION_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-chat
# AGENT_MAX_STEPS=80
